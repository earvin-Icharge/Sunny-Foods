{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron/push",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "10 16 * * *"
    }
  ]
}

# Copy to .env.local for your computer. On Vercel, add the same names in Project → Settings → Environment Variables.

# Supabase (Project Settings → API Keys). Use the NEW keys only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx           # server only — never in browser code

# Database connection for the server (Project → Connect → Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Main domain (subdomains app., order., agent. are added automatically)
NEXT_PUBLIC_ROOT_DOMAIN=sunnyfoods.com.ph

# Web push (generate once with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@sunnyfoods.com.ph

# Protects the scheduled-job URLs (Vercel Cron sends it automatically)
CRON_SECRET=change-me

# Phone login codes by text (Supabase "Send SMS" hook -> /api/auth/sms-hook -> Semaphore)
SMS_HOOK_SECRET=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
